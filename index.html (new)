      document.getElementById('filter-brok').classList.toggle('on',STATE.filterBrok!==false);
      document.getElementById('filter-dev').classList.toggle('on',STATE.filterDev!==false);
      document.getElementById('deal-filter-brok').classList.toggle('on',STATE.dealFilterBrok!==false);
      document.getElementById('deal-filter-dev').classList.toggle('on',STATE.dealFilterDev!==false);
      toast('Data synced from cloud ☁️');
    }
  }catch(e){console.warn('Supabase pull failed:',e);}
}

// Subscribe to real-time changes from other devices
function subscribeToSupabase(){
  sbClient.channel('cre_state_changes')
    .on('postgres_changes',{event:'UPDATE',schema:'public',table:'cre_state'},
      payload=>{
        const remote=payload.new?.data;
        if(!remote||!remote.tasks) return;
        const remoteTs=new Date(payload.new.updated_at).getTime();
        const localTs=STATE._savedAt||0;
        if(remoteTs>localTs+2000){ // 2s buffer to avoid echo
          STATE=remote;
          STATE._savedAt=remoteTs;
          try{localStorage.setItem(STORE_KEY,JSON.stringify(STATE));}catch(e){}
          renderWeek();renderKPIs();renderProjects();renderFollowups();
          renderDeals();renderContacts();renderMap();
          toast('Synced from another device ☁️');
        }
      })
    .subscribe();
}

