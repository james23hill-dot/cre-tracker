function saveDeal(existingId){
  const name=document.getElementById('f-dname').value.trim();if(!name){toast('Please enter a deal name.');return;}
  const type=document.getElementById('f-dtype').value,stage=document.getElementById('f-dstage').value,location=document.getElementById('f-dloc').value.trim(),size=document.getElementById('f-dsize').value.trim(),level=parseInt(document.getElementById('f-dlevel').value)||0;
  const feeEl=document.getElementById('f-dfee'),fee=feeEl?parseInt(feeEl.value)||0:0;
  const projectId=document.getElementById('f-dproject').value;
  const dateFirstContact=document.getElementById('f-ddate-first')?.value||'';
  const dateLoiSent=document.getElementById('f-ddate-loi')?.value||'';
  const dateLeaseSent=document.getElementById('f-ddate-lease')?.value||'';
  // Quick contact entry
  const qcName=(document.getElementById('qc-name')?.value||'').trim();
  const qcCompany=(document.getElementById('qc-company')?.value||'').trim();
  const qcPhone=(document.getElementById('qc-phone')?.value||'').trim();
  const qcEmail=(document.getElementById('qc-email')?.value||'').trim();
  const dealId=existingId||uid();
  if(qcName&&!selectedDealContacts.find(c=>c.name.toLowerCase()===qcName.toLowerCase())){
    const existing=STATE.contacts.find(c=>c.name.toLowerCase()===qcName.toLowerCase()||(qcEmail&&c.email===qcEmail));
    if(existing){if(qcCompany)existing.company=qcCompany;if(qcPhone)existing.phone=qcPhone;if(qcEmail)existing.email=qcEmail;if(!selectedDealContacts.find(c=>c.id===existing.id))selectedDealContacts.push({id:existing.id,name:existing.name,ini:existing.ini,isNew:false});}
    else selectedDealContacts.push({id:null,name:qcName,ini:initials(qcName),isNew:true,company:qcCompany,phone:qcPhone,email:qcEmail});
  }
  const finalContactIds=saveNewContactsFromArr(selectedDealContacts,dealId);
  // Fill in quick contact details on the newly created contact
  if(qcName){const nc=STATE.contacts.find(c=>c.name===qcName);if(nc){if(qcCompany)nc.company=qcCompany;if(qcPhone)nc.phone=qcPhone;if(qcEmail)nc.email=qcEmail;}}
  STATE.contacts.forEach(c=>{c.linkedDeals=(c.linkedDeals||[]).filter(id=>id!==dealId);});
  finalContactIds.forEach(cid=>{const c=STATE.contacts.find(x=>x.id===cid);if(c){if(!c.linkedDeals)c.linkedDeals=[];if(!c.linkedDeals.includes(dealId))c.linkedDeals.push(dealId);}});
  if(existingId){const d=STATE.deals.find(x=>x.id===existingId);if(d)Object.assign(d,{name,type,stage,location,size,level,fee,projectId,dateFirstContact,dateLoiSent,dateLeaseSent});}
  else STATE.deals.push({id:dealId,name,type,stage,location,size,level,fee,projectId,dateFirstContact,dateLoiSent,dateLeaseSent,value:0});
  saveState();closeModal();renderDeals();renderKPIs();renderMap();renderContacts();renderContactDetail(STATE.selectedContact);renderProjectsTab();
  const newCount=selectedDealContacts.filter(c=>c.isNew).length;
  toast(existingId?`Deal updated \u00b7 ${finalContactIds.length} contact(s) linked`:`Deal added \u00b7 ${finalContactIds.length} contact(s) linked${newCount?` \u00b7 ${newCount} new contact(s) created`:''}`);
  selectedDealContacts=[];
}
function deleteDeal(id){if(!confirm('Delete this deal?'))return;STATE.deals=STATE.deals.filter(x=>x.id!==id);saveState();closeModal();renderDeals();renderKPIs();renderMap();toast('Deal deleted.');}

