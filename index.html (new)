<!DOCTYPE html>
<html lang="en" data-theme="dark" data-density="comfortable">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1"/>
<title>CRE HQ · Carolinas Desk</title>
<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet"/>
<script src="https://alcdn.msauth.net/browser/2.38.3/js/msal-browser.min.js" onerror="msalLoadFailed=true"></script>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<style>
:root {
  --paper:#f4f3ef;--surface:#ffffff;--surface-2:#faf9f6;--surface-3:#f0eee8;
  --ink:#1e1c19;--ink-2:#6b6760;--ink-3:#9c978d;--line:#e7e4dc;--line-2:#f0eee9;
  --tint-bg:#ffffff;
  --brok:#4f82c6;--brok-soft:color-mix(in oklab,var(--brok) 13%,var(--tint-bg));--brok-line:color-mix(in oklab,var(--brok) 38%,var(--tint-bg));
  --dev:#c08b3e;--dev-soft:color-mix(in oklab,var(--dev) 15%,var(--tint-bg));--dev-line:color-mix(in oklab,var(--dev) 40%,var(--tint-bg));
  --good:oklch(0.56 0.09 150);--good-soft:color-mix(in oklab,var(--good) 14%,var(--tint-bg));
  --danger:oklch(0.55 0.15 28);--danger-soft:color-mix(in oklab,var(--danger) 14%,var(--tint-bg));
  --warn:oklch(0.62 0.13 65);
  --sans:"IBM Plex Sans",system-ui,sans-serif;--mono:"IBM Plex Mono",monospace;
  --r:12px;--r-sm:8px;--r-xs:6px;
  --sh:0 1px 2px rgba(31,28,25,.05),0 1px 1px rgba(31,28,25,.04);
  --sh-2:0 4px 14px rgba(31,28,25,.08),0 1px 3px rgba(31,28,25,.05);
  --gut:18px;
}
[data-density="compact"]{--gut:12px;}
html[data-theme="dark"]{
  --paper:#15130f;--surface:#1f1c16;--surface-2:#1a1712;--surface-3:#2c2820;
  --ink:#efece3;--ink-2:#a7a299;--ink-3:#746e63;--line:#332e25;--line-2:#272219;--tint-bg:#1f1c16;
  --good:oklch(0.74 0.10 150);--danger:oklch(0.72 0.14 28);--warn:oklch(0.82 0.11 70);
  --sh:0 1px 2px rgba(0,0,0,.45);--sh-2:0 6px 18px rgba(0,0,0,.55);
}
*{box-sizing:border-box;}
html,body{margin:0;background:var(--paper);color:var(--ink);font-family:var(--sans);font-size:14.5px;line-height:1.45;-webkit-font-smoothing:antialiased;}
h1,h2,h3,h4{margin:0;font-weight:600;letter-spacing:-0.01em;}p{margin:0;}
button,input,select,textarea{font-family:inherit;}button{cursor:pointer;}
input,select,textarea{background:var(--surface);color:var(--ink);border:1px solid var(--line);border-radius:var(--r-sm);padding:7px 10px;font-size:13.5px;outline:none;width:100%;}
input:focus,select:focus,textarea:focus{border-color:var(--ink-3);}
.mono{font-family:var(--mono);}.muted{color:var(--ink-2);}.faint{color:var(--ink-3);}.tiny{font-size:12px;}
.up{color:var(--good);}.down{color:var(--danger);}a{color:var(--brok);text-decoration:none;}

/* APP BAR */
.appbar{position:sticky;top:0;z-index:40;display:flex;align-items:center;gap:22px;height:60px;padding:0 22px;background:var(--surface);border-bottom:1px solid var(--line);}
.brand{display:flex;align-items:center;gap:11px;flex-shrink:0;}
.brand .mark{width:34px;height:34px;border-radius:9px;background:var(--ink);color:var(--paper);display:grid;place-items:center;font-weight:700;font-size:15px;letter-spacing:-0.03em;}
.brand .name{font-weight:600;font-size:16px;letter-spacing:-0.02em;white-space:nowrap;}
.brand .name span{color:var(--ink-3);font-weight:500;}
.ticker{display:flex;gap:18px;align-items:center;padding:5px 12px;background:var(--surface-2);border:1px solid var(--line);border-radius:99px;flex-shrink:0;}
.ticker .ti{display:flex;align-items:baseline;gap:6px;font-size:12.5px;}
.ticker .ti .k{color:var(--ink-2);font-weight:500;}.ticker .ti .v{font-family:var(--mono);font-weight:600;font-size:13px;}.ticker .ti .c{font-family:var(--mono);font-size:11px;}
.appbar .spacer{flex:1;}
.search-box{display:flex;align-items:center;gap:8px;width:230px;padding:7px 12px;background:var(--surface-2);border:1px solid var(--line);border-radius:9px;color:var(--ink-3);font-size:13.5px;cursor:text;}
.btn{display:inline-flex;align-items:center;gap:7px;height:36px;padding:0 14px;border:1px solid var(--line);background:var(--surface);border-radius:9px;font-size:13.5px;font-weight:500;color:var(--ink);box-shadow:var(--sh);}
.btn:hover{background:var(--surface-2);}.btn.primary{background:var(--ink);color:var(--paper);border-color:var(--ink);}.btn.primary:hover{opacity:.9;}
.btn.danger{background:var(--danger-soft);color:var(--danger);border-color:transparent;}.btn .plus{font-size:17px;line-height:1;margin-top:-1px;}.btn.sm{height:30px;padding:0 10px;font-size:12.5px;}
.avatar{width:34px;height:34px;border-radius:50%;background:var(--surface-3);border:1px solid var(--line);display:grid;place-items:center;font-size:13px;font-weight:600;color:var(--ink-2);flex-shrink:0;cursor:pointer;}

/* TAB NAV */
.tabnav{display:flex;gap:2px;align-items:stretch;height:46px;padding:0 22px;background:var(--surface);border-bottom:1px solid var(--line);position:sticky;top:60px;z-index:39;}
.tabnav button{position:relative;border:none;background:none;padding:0 16px;font-size:14px;font-weight:500;color:var(--ink-2);display:inline-flex;align-items:center;gap:8px;}
.tabnav button:hover{color:var(--ink);}.tabnav button[aria-selected="true"]{color:var(--ink);font-weight:600;}
.tabnav button[aria-selected="true"]::after{content:"";position:absolute;left:12px;right:12px;bottom:-1px;height:2px;background:var(--ink);border-radius:2px;}
.tabnav .count{font-family:var(--mono);font-size:11px;padding:1px 7px;border-radius:99px;background:var(--surface-3);color:var(--ink-2);}

/* LAYOUT */
.wrap{padding:20px 22px 60px;max-width:1640px;margin:0 auto;}.screen{display:none;}.screen.active{display:block;}

/* TAGS / CHIPS / BADGES */
.tag{display:inline-flex;align-items:center;gap:5px;font-size:11.5px;font-weight:600;padding:2px 9px;border-radius:99px;letter-spacing:.01em;}
.tag::before{content:"";width:6px;height:6px;border-radius:50%;background:currentColor;}
.tag.brok{color:var(--brok);background:var(--brok-soft);}.tag.dev{color:var(--dev);background:var(--dev-soft);}
.chip{display:inline-flex;align-items:center;gap:6px;font-size:12.5px;font-weight:500;padding:4px 11px;border:1px solid var(--line);border-radius:99px;background:var(--surface);color:var(--ink-2);cursor:pointer;white-space:nowrap;}
.chip:hover{border-color:var(--ink-3);color:var(--ink);}.chip.on,.chip[data-on="true"]{color:var(--ink);border-color:var(--ink-3);background:var(--surface-2);}
.chip.brok.on,.chip.brok[data-on="true"]{color:var(--brok);border-color:var(--brok-line);background:var(--brok-soft);}
.chip.dev.on,.chip.dev[data-on="true"]{color:var(--dev);border-color:var(--dev-line);background:var(--dev-soft);}
.chip::before{content:"";width:7px;height:7px;border-radius:50%;background:currentColor;opacity:.9;}.chip.nofill::before{display:none;}
.badge{font-family:var(--mono);font-size:11px;font-weight:600;padding:2px 8px;border-radius:6px;white-space:nowrap;border:1px solid var(--line);}
.badge.over{color:var(--danger);background:var(--danger-soft);border-color:transparent;}.badge.today{color:var(--warn);background:var(--dev-soft);border-color:transparent;}
.badge.good{color:var(--good);background:var(--good-soft);border-color:transparent;}.badge.time{color:var(--ink-2);background:var(--surface-2);}

/* PANELS */
.panel{background:var(--surface);border:1px solid var(--line);border-radius:var(--r);box-shadow:var(--sh);}
.panel-h{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:13px 16px;border-bottom:1px solid var(--line-2);}
.panel-h h3{font-size:14.5px;}.panel-h .sub{font-size:12px;color:var(--ink-3);}.panel-b{padding:14px 16px;}.panel-b.tight{padding:6px 16px;}

/* KPI STRIP */
.kpis{display:grid;grid-template-columns:repeat(4,1fr);gap:var(--gut);margin-bottom:var(--gut);}
.kpi{background:var(--surface);border:1px solid var(--line);border-radius:var(--r);padding:14px 16px;box-shadow:var(--sh);}
.kpi .k{font-size:12.5px;color:var(--ink-2);display:flex;align-items:center;gap:7px;}.kpi .v{font-family:var(--mono);font-size:27px;font-weight:600;letter-spacing:-0.02em;margin-top:4px;}.kpi .sub{font-size:12px;margin-top:3px;}
.kpi.alert{border-color:var(--danger-soft);}.kpi.alert .v{color:var(--danger);}.kpi.ring-kpi{display:flex;align-items:center;gap:16px;}
.dotk{width:8px;height:8px;border-radius:50%;}
.ring{position:relative;width:74px;height:74px;flex:0 0 auto;}.ring svg{width:100%;height:100%;transform:rotate(-90deg);}
.ring .track{fill:none;stroke:var(--surface-3);stroke-width:8;}.ring .prog{fill:none;stroke:var(--good);stroke-width:8;stroke-linecap:round;stroke-dasharray:213.6;stroke-dashoffset:213.6;transition:stroke-dashoffset .55s cubic-bezier(.22,1,.36,1);}
.ring-pct{position:absolute;inset:0;display:grid;place-items:center;font-family:var(--mono);font-weight:600;font-size:17px;letter-spacing:-0.02em;}

/* COMMAND CENTER */
.cc{display:grid;grid-template-columns:290px 1fr 320px;gap:var(--gut);align-items:start;}.col{display:grid;gap:var(--gut);}

/* NEWS */
.news .item{padding:11px 0;border-bottom:1px solid var(--line-2);}.news .item:last-child{border-bottom:none;}
.news .item .src{font-family:var(--mono);font-size:10.5px;text-transform:uppercase;letter-spacing:.06em;color:var(--ink-3);display:flex;gap:7px;align-items:center;margin-bottom:3px;}
.news .item .src .geo{color:var(--brok);}.news .item .hl{font-size:13.5px;line-height:1.35;cursor:pointer;}.news .item:hover .hl{text-decoration:underline;}

/* RATES */
.rate{display:grid;grid-template-columns:1fr auto;align-items:center;gap:10px;padding:11px 0;border-bottom:1px solid var(--line-2);}.rate:last-child{border-bottom:none;}
.rate .nm{font-size:12.5px;color:var(--ink-2);}.rate .big{font-family:var(--mono);font-size:22px;font-weight:600;letter-spacing:-0.02em;}
.rate .spark{width:90px;height:30px;}.rate .spark path{fill:none;stroke:var(--ink-3);stroke-width:1.6;}.rate .chg{font-family:var(--mono);font-size:11.5px;text-align:right;margin-top:2px;}

/* WEEK GRID */
.weekhead{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:12px;flex-wrap:wrap;}
.weekhead .nav{display:inline-flex;border:1px solid var(--line);border-radius:8px;overflow:hidden;box-shadow:var(--sh);}
.weekhead .nav button{border:none;background:var(--surface);padding:7px 11px;font-size:13px;border-right:1px solid var(--line);}
.weekhead .nav button:last-child{border-right:none;}.weekhead .nav button:hover{background:var(--surface-2);}
.weekgrid{display:grid;grid-template-columns:repeat(5,1fr);gap:10px;}
.day{background:var(--surface);border:1px solid var(--line);border-radius:var(--r);min-height:300px;box-shadow:var(--sh);display:flex;flex-direction:column;}
.day.today{border-color:var(--ink-3);}
.day .dh{display:flex;align-items:baseline;justify-content:space-between;padding:10px 11px;border-bottom:1px solid var(--line-2);flex-wrap:wrap;gap:4px;}
.day.today .dh{background:var(--surface-2);}.day .dh .dow{font-size:13px;font-weight:600;}.day .dh .dn{font-family:var(--mono);font-size:11px;color:var(--ink-3);}
.day.today .dh .dn{color:var(--warn);font-weight:600;}.day .dbody{padding:8px;display:flex;flex-direction:column;gap:7px;flex:1;}
.task{border:1px solid var(--line);border-left:3px solid var(--ink-3);border-radius:var(--r-sm);padding:8px 9px;background:var(--surface);transition:box-shadow .12s;}
.task:hover{box-shadow:var(--sh-2);}.task.brok{border-left-color:var(--brok);}.task.dev{border-left-color:var(--dev);}
.task.is-over{background:var(--danger-soft);border-color:transparent;}
.task .ttop{display:flex;gap:8px;align-items:flex-start;}.task .ttl{font-size:12.5px;line-height:1.3;flex:1;}
.task.done .ttl{color:var(--ink-3);text-decoration:line-through;}
.task .tmeta{display:flex;gap:6px;align-items:center;flex-wrap:wrap;margin-top:7px;margin-left:24px;}
.task .tproj{font-size:11px;color:var(--ink-2);background:var(--surface-3);padding:1px 7px;border-radius:5px;}
.cbx{width:16px;height:16px;border:1.6px solid var(--ink-3);border-radius:5px;flex:0 0 auto;margin-top:1px;display:grid;place-items:center;background:var(--surface);cursor:pointer;transition:background .1s,border-color .1s;}
.cbx:hover{border-color:var(--ink);}.cbx.on{background:var(--ink);border-color:var(--ink);}
.cbx.on::after{content:"✓";color:var(--paper);font-size:11px;line-height:1;}
.task-actions{display:flex;gap:4px;margin-left:auto;}
.task-actions button{background:none;border:none;color:var(--ink-3);font-size:11px;padding:2px 5px;border-radius:4px;height:auto;}
.task-actions button:hover{color:var(--danger);background:var(--danger-soft);}
.addt{border:1px dashed var(--line);color:var(--ink-3);border-radius:var(--r-sm);padding:6px;font-size:12px;text-align:center;background:var(--surface-2);cursor:pointer;}
.addt:hover{color:var(--ink-2);border-color:var(--ink-3);}.task.hide{display:none;}

/* RIGHT RAIL */
.proj-item{padding:11px 0;border-bottom:1px solid var(--line-2);}.proj-item:last-child{border-bottom:none;}
.proj-item .pt{display:flex;justify-content:space-between;align-items:center;gap:8px;}
.proj-item .pn{font-size:13.5px;font-weight:500;flex:1;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.proj-item .pm{font-size:11.5px;color:var(--ink-2);margin:5px 0 7px;}
.bar{height:6px;border-radius:99px;background:var(--surface-3);overflow:hidden;}.bar>span{display:block;height:100%;border-radius:99px;background:var(--dev);}.bar.brok>span{background:var(--brok);}
.fu{display:grid;grid-template-columns:auto 1fr auto;gap:10px;align-items:center;padding:9px 0;border-bottom:1px solid var(--line-2);cursor:pointer;}.fu:last-child{border-bottom:none;}
.fu .who{font-size:13px;font-weight:500;}.fu .why{font-size:11.5px;color:var(--ink-2);}
.fu .av{width:30px;height:30px;border-radius:50%;background:var(--surface-3);display:grid;place-items:center;font-size:11px;font-weight:600;color:var(--ink-2);}

/* DEAL TRACKER */
.toolbar{display:flex;gap:9px;align-items:center;flex-wrap:wrap;margin-bottom:14px;}
.kan{display:grid;grid-template-columns:repeat(5,1fr);gap:var(--gut);align-items:start;}
.kcol{background:var(--surface-2);border:1px solid var(--line);border-radius:var(--r);min-height:200px;}
.kcol .kh{display:flex;align-items:center;justify-content:space-between;padding:11px 13px;border-bottom:1px solid var(--line);}
.kcol .kh .kt{font-size:13px;font-weight:600;}.kcol .kh .ks{font-family:var(--mono);font-size:11px;color:var(--ink-2);}
.kcol .ksum{font-family:var(--mono);font-size:11.5px;color:var(--ink-2);padding:7px 13px;border-bottom:1px solid var(--line-2);}
.kcol .kb{padding:10px;display:flex;flex-direction:column;gap:10px;}
.deal{background:var(--surface);border:1px solid var(--line);border-top:3px solid var(--ink-3);border-radius:var(--r-sm);padding:11px;box-shadow:var(--sh);cursor:pointer;transition:box-shadow .12s,transform .12s;}
.deal:hover{box-shadow:var(--sh-2);transform:translateY(-1px);}.deal.brok{border-top-color:var(--brok);}.deal.dev{border-top-color:var(--dev);}
.deal .dn{font-size:13.5px;font-weight:600;}.deal .ds{font-size:11.5px;color:var(--ink-2);margin:4px 0 9px;}
.deal .df{display:flex;align-items:center;justify-content:space-between;margin-top:9px;}.deal.closed-deal{opacity:.65;}
.level{display:inline-flex;gap:3px;align-items:center;}.level i{width:6px;height:14px;border-radius:2px;background:var(--surface-3);}
.level i.on{background:var(--ink-3);}.level.hot i.on{background:var(--dev);}.level.max i.on{background:var(--good);}

/* CONTACTS */
.ct{display:grid;grid-template-columns:1fr 360px;gap:var(--gut);}.table-wrap{overflow:auto;}
.table{width:100%;border-collapse:collapse;}
.table th{text-align:left;font-size:11.5px;font-weight:600;text-transform:uppercase;letter-spacing:.05em;color:var(--ink-3);padding:11px 14px;border-bottom:1px solid var(--line);}
.table td{padding:12px 14px;border-bottom:1px solid var(--line-2);font-size:13.5px;}.table tr.clickable{cursor:pointer;}
.table tbody tr.clickable:hover td{background:var(--surface-2);}.table tr.sel td{background:var(--brok-soft);}
.ctname{display:flex;align-items:center;gap:10px;font-weight:500;}
.av-sm{width:30px;height:30px;border-radius:50%;background:var(--surface-3);display:grid;place-items:center;font-size:11px;font-weight:600;color:var(--ink-2);flex-shrink:0;}
.detail{overflow:hidden;}.detail .dtop{display:flex;gap:13px;align-items:center;padding:16px;border-bottom:1px solid var(--line-2);}
.detail .av-lg{width:54px;height:54px;border-radius:50%;background:var(--surface-3);display:grid;place-items:center;font-size:18px;font-weight:600;color:var(--ink-2);flex-shrink:0;}
.detail .nm{font-size:17px;font-weight:600;}.detail .co{font-size:12.5px;color:var(--ink-2);}
.field{display:grid;grid-template-columns:92px 1fr;gap:10px;padding:9px 16px;font-size:13px;border-bottom:1px solid var(--line-2);}
.field .fl{color:var(--ink-3);font-size:12px;padding-top:1px;}
.subhead{font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.06em;color:var(--ink-3);padding:10px 16px 6px;}
.link{display:flex;align-items:center;justify-content:space-between;padding:7px 16px;border-bottom:1px solid var(--line-2);}.link:last-child{border-bottom:none;}
.logitem{padding:9px 16px;border-bottom:1px solid var(--line-2);}
.logitem .when{font-family:var(--mono);font-size:10.5px;text-transform:uppercase;letter-spacing:.06em;color:var(--ink-3);margin-bottom:3px;}.logitem:last-child{border-bottom:none;}

/* MAP */
.mapgrid{display:grid;grid-template-columns:1fr 340px;gap:var(--gut);}
.mapcanvas{position:relative;min-height:550px;border-radius:var(--r);overflow:hidden;background:radial-gradient(120% 90% at 65% 30%,oklch(0.85 0.02 235) 0%,oklch(0.82 0.02 150) 58%,oklch(0.80 0.02 120) 100%);border:1px solid var(--line);}
html[data-theme="dark"] .mapcanvas{background:radial-gradient(120% 90% at 65% 30%,oklch(0.27 0.02 235) 0%,oklch(0.24 0.02 150) 58%,oklch(0.22 0.02 120) 100%);}
.map-nc-label,.map-sc-label{position:absolute;font-family:var(--mono);font-size:10px;font-weight:600;letter-spacing:.15em;text-transform:uppercase;color:var(--ink-3);pointer-events:none;}
.map-nc-label{left:45%;top:15%;}.map-sc-label{left:20%;top:72%;}
.maptools{position:absolute;top:14px;left:14px;display:flex;gap:6px;}
.mapzoom{position:absolute;top:14px;right:14px;display:flex;flex-direction:column;border:1px solid var(--line);border-radius:8px;overflow:hidden;background:var(--surface);}
.mapzoom button{border:none;background:none;width:32px;height:32px;font-size:16px;color:var(--ink-2);}
.mapzoom button:hover{background:var(--surface-2);}.mapzoom button:first-child{border-bottom:1px solid var(--line);}
.wm{position:absolute;bottom:10px;left:50%;transform:translateX(-50%);font-family:var(--mono);font-size:10px;color:var(--ink-3);white-space:nowrap;}
.carolinas-svg{position:absolute;inset:0;width:100%;height:100%;}
.pin{position:absolute;transform:translate(-50%,-100%);cursor:pointer;z-index:2;}
.pin-head{width:26px;height:26px;border-radius:50% 50% 50% 0;transform:rotate(-45deg);display:grid;place-items:center;border:2px solid rgba(255,255,255,.25);}
.pin-head span{transform:rotate(45deg);font-family:var(--mono);font-size:10px;font-weight:600;color:#fff;}
.pin.brok .pin-head{background:var(--brok);}.pin.dev .pin-head{background:var(--dev);}.pin.active .pin-head{background:var(--ink);}
.pin-lbl{font-family:var(--mono);font-size:9.5px;font-weight:600;text-align:center;color:var(--ink-2);margin-top:4px;white-space:nowrap;}
.drow{display:grid;grid-template-columns:32px 1fr auto;gap:10px;align-items:center;padding:9px 16px;cursor:pointer;border-bottom:1px solid var(--line-2);}
.drow:last-child{border-bottom:none;}.drow:hover{background:var(--surface-2);}.drow.sel{background:var(--brok-soft);}
.drow .pn{width:26px;height:26px;border-radius:50%;background:var(--surface-3);display:grid;place-items:center;font-family:var(--mono);font-size:11px;font-weight:600;color:var(--ink-2);flex-shrink:0;}
.drow .dn{font-size:13px;font-weight:500;}.drow .dl{font-size:11.5px;color:var(--ink-2);}
.legend{display:flex;gap:20px;align-items:center;margin-top:12px;font-size:12.5px;color:var(--ink-2);}
.legend .li{display:flex;align-items:center;gap:7px;}.legend .sw{width:12px;height:12px;border-radius:50%;}

/* MODAL */
.modal-backdrop{position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:100;display:flex;align-items:center;justify-content:center;padding:20px;}
.modal{background:var(--surface);border:1px solid var(--line);border-radius:var(--r);box-shadow:var(--sh-2);width:100%;max-width:520px;max-height:90vh;overflow-y:auto;}
.modal-h{display:flex;align-items:center;justify-content:space-between;padding:16px 20px;border-bottom:1px solid var(--line);}
.modal-h h3{font-size:16px;}.modal-close{background:none;border:none;font-size:20px;color:var(--ink-3);line-height:1;padding:0;width:28px;height:28px;border-radius:6px;}
.modal-close:hover{background:var(--surface-2);color:var(--ink);}.modal-b{padding:20px;}
.form-row{margin-bottom:14px;}
.form-row label{display:block;font-size:12px;font-weight:600;color:var(--ink-2);text-transform:uppercase;letter-spacing:.05em;margin-bottom:5px;}
.form-row-2{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:14px;}
.modal-footer{display:flex;gap:9px;justify-content:flex-end;padding:14px 20px;border-top:1px solid var(--line);}

/* FOLLOW-UP SIDE-BY-SIDE */
.fu-row{display:grid;grid-template-columns:1fr auto 1fr;gap:8px;align-items:center;}
.fu-or{font-size:11px;font-weight:600;color:var(--ink-3);text-align:center;padding:0 2px;}

/* QUICK CONTACT ENTRY */
.qc-box{background:var(--surface-2);border:1px solid var(--line);border-radius:var(--r-sm);padding:14px;margin-top:4px;}
.qc-box-title{font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.06em;color:var(--ink-3);margin-bottom:10px;}

/* TOAST */
.toast{position:fixed;bottom:24px;left:50%;transform:translateX(-50%) translateY(10px);background:var(--ink);color:var(--paper);padding:10px 20px;border-radius:10px;font-size:13.5px;z-index:200;opacity:0;transition:opacity .2s,transform .2s;pointer-events:none;white-space:nowrap;}
.toast.show{opacity:1;transform:translateX(-50%) translateY(0);}

/* SETTINGS */
.settings-panel{position:fixed;top:60px;right:0;width:280px;height:calc(100vh - 60px);background:var(--surface);border-left:1px solid var(--line);z-index:50;padding:20px;overflow-y:auto;transform:translateX(100%);transition:transform .2s;}
.settings-panel.open{transform:translateX(0);}.settings-panel h3{font-size:14px;margin-bottom:16px;}
.settings-section{margin-bottom:20px;}
.settings-section label{display:block;font-size:12px;font-weight:600;color:var(--ink-2);text-transform:uppercase;letter-spacing:.05em;margin-bottom:8px;}
.toggle-row{display:flex;align-items:center;justify-content:space-between;font-size:13.5px;margin-bottom:10px;}
.toggle{position:relative;width:38px;height:22px;cursor:pointer;}.toggle input{opacity:0;width:0;height:0;}
.toggle-slider{position:absolute;inset:0;background:var(--surface-3);border-radius:99px;transition:background .2s;}
.toggle-slider::after{content:"";position:absolute;width:16px;height:16px;left:3px;top:3px;border-radius:50%;background:var(--ink-3);transition:transform .2s,background .2s;}
.toggle input:checked+.toggle-slider{background:var(--ink);}.toggle input:checked+.toggle-slider::after{transform:translateX(16px);background:var(--paper);}

/* PROJECTS TAB */
.proj-card{background:var(--surface);border:1px solid var(--line);border-top:3px solid var(--ink-3);border-radius:var(--r);box-shadow:var(--sh);overflow:hidden;}
.proj-card.dev{border-top-color:var(--dev);}.proj-card.brok{border-top-color:var(--brok);}
.proj-card-h{display:flex;align-items:flex-start;justify-content:space-between;gap:10px;padding:14px 16px 10px;}
.proj-card-h .pname{font-size:15px;font-weight:600;flex:1;}.proj-card-h .pactions{display:flex;gap:6px;flex-shrink:0;}
.proj-meta{padding:0 16px 10px;font-size:12.5px;color:var(--ink-2);}
.proj-progress{padding:0 16px 12px;}
.proj-progress .bar-label{display:flex;justify-content:space-between;font-size:11.5px;color:var(--ink-3);margin-bottom:5px;}.proj-progress .bar{height:8px;}
.proj-deals-section{border-top:1px solid var(--line-2);padding:12px 16px;}
.proj-deals-section .pdeal-h{font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.06em;color:var(--ink-3);margin-bottom:8px;}
.proj-deal-row{display:flex;align-items:center;gap:8px;padding:6px 0;border-bottom:1px solid var(--line-2);font-size:13px;}.proj-deal-row:last-child{border-bottom:none;}
.proj-deal-row .dname{flex:1;font-weight:500;}.proj-deal-row .dstage{font-size:11.5px;color:var(--ink-2);}.proj-deal-row .dval{font-family:var(--mono);font-size:12px;font-weight:600;color:var(--ink-2);}
.proj-tasks-section{border-top:1px solid var(--line-2);padding:10px 16px;}
.proj-tasks-section .ptask-h{font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.06em;color:var(--ink-3);margin-bottom:6px;}
.proj-task-row{display:flex;align-items:center;gap:8px;padding:4px 0;font-size:12.5px;}
.proj-task-row .cbx-sm{width:13px;height:13px;border:1.5px solid var(--ink-3);border-radius:3px;flex-shrink:0;}
.proj-empty{padding:20px;text-align:center;color:var(--ink-3);font-size:13px;}

/* IMPORTANCE */
.imp{display:inline-flex;gap:3px;align-items:center;flex-shrink:0;}.imp span{width:7px;height:7px;border-radius:50%;background:var(--surface-3);}.imp span.on{background:var(--ink-3);}
.imp.i1 span.on,.imp.i2 span.on{background:var(--good);}.imp.i3 span.on{background:var(--warn);}.imp.i4 span.on,.imp.i5 span.on{background:var(--danger);}
.task .contact-link{font-size:11px;color:var(--brok);background:var(--brok-soft);padding:1px 7px;border-radius:5px;cursor:pointer;}
.task .contact-link:hover{text-decoration:underline;}
.imp-picker{display:flex;gap:6px;align-items:center;}
.imp-picker button{width:32px;height:32px;border:1.5px solid var(--line);border-radius:8px;background:var(--surface);font-size:13px;font-weight:600;color:var(--ink-2);transition:all .1s;}
.imp-picker button:hover{border-color:var(--ink-3);color:var(--ink);}.imp-picker button.sel{background:var(--ink);color:var(--paper);border-color:var(--ink);}
.imp-picker button[data-v="4"].sel,.imp-picker button[data-v="5"].sel{background:var(--danger);border-color:var(--danger);}
.imp-picker button[data-v="3"].sel{background:var(--warn);border-color:var(--warn);}
.imp-picker button[data-v="1"].sel,.imp-picker button[data-v="2"].sel{background:var(--good);border-color:var(--good);}

/* CONTACT AUTOCOMPLETE */
.contact-input-wrap{position:relative;}.contact-input-wrap input{width:100%;}
.contact-suggestions{position:absolute;top:100%;left:0;right:0;background:var(--surface);border:1px solid var(--line);border-top:none;border-radius:0 0 var(--r-sm) var(--r-sm);box-shadow:var(--sh-2);z-index:200;max-height:180px;overflow-y:auto;}
.contact-suggestions .sug-item{padding:9px 12px;cursor:pointer;font-size:13.5px;border-bottom:1px solid var(--line-2);display:flex;align-items:center;gap:8px;}
.contact-suggestions .sug-item:last-child{border-bottom:none;}.contact-suggestions .sug-item:hover{background:var(--surface-2);}
.contact-suggestions .sug-new{color:var(--brok);font-style:italic;}
.contact-suggestions .sug-av{width:24px;height:24px;border-radius:50%;background:var(--surface-3);display:grid;place-items:center;font-size:10px;font-weight:600;color:var(--ink-2);flex-shrink:0;}
.contact-tags{display:flex;flex-wrap:wrap;gap:6px;margin-top:8px;}
.contact-tag{display:inline-flex;align-items:center;gap:5px;background:var(--brok-soft);color:var(--brok);border:1px solid var(--brok-line);border-radius:99px;padding:3px 10px 3px 8px;font-size:12.5px;font-weight:500;}
.contact-tag button{background:none;border:none;color:var(--brok);font-size:14px;line-height:1;padding:0;cursor:pointer;opacity:.7;}.contact-tag button:hover{opacity:1;}

/* LOGIN */
.login-screen{position:fixed;inset:0;background:var(--paper);z-index:999;display:flex;align-items:center;justify-content:center;padding:20px;}
.login-box{background:var(--surface);border:1px solid var(--line);border-radius:16px;box-shadow:var(--sh-2);width:100%;max-width:400px;padding:40px;}
.login-logo{display:flex;align-items:center;gap:12px;margin-bottom:32px;}
.login-mark{width:44px;height:44px;border-radius:12px;background:var(--ink);color:var(--paper);display:grid;place-items:center;font-weight:700;font-size:19px;letter-spacing:-0.03em;flex-shrink:0;}
.login-title{font-size:20px;font-weight:700;letter-spacing:-0.02em;}.login-sub{font-size:13px;color:var(--ink-3);margin-top:2px;}
.login-label{display:block;font-size:11.5px;font-weight:600;color:var(--ink-2);text-transform:uppercase;letter-spacing:.06em;margin-bottom:6px;}
.login-input{width:100%;background:var(--surface-2);border:1px solid var(--line);border-radius:9px;padding:11px 14px;font-size:14.5px;color:var(--ink);outline:none;font-family:var(--sans);}
.login-input:focus{border-color:var(--ink-3);}.login-field{margin-bottom:18px;}
.login-btn{width:100%;height:44px;background:var(--ink);color:var(--paper);border:none;border-radius:9px;font-size:14.5px;font-weight:600;cursor:pointer;margin-top:8px;font-family:var(--sans);letter-spacing:-0.01em;}
.login-btn:hover{opacity:.88;}.login-error{background:var(--danger-soft);color:var(--danger);border-radius:8px;padding:10px 14px;font-size:13px;margin-bottom:16px;display:none;}
.login-error.show{display:block;}.login-footer{text-align:center;margin-top:20px;font-size:12px;color:var(--ink-3);}

::-webkit-scrollbar{width:6px;height:6px;}::-webkit-scrollbar-track{background:transparent;}::-webkit-scrollbar-thumb{background:var(--line);border-radius:3px;}::-webkit-scrollbar-thumb:hover{background:var(--ink-3);}
@media(max-width:1100px){.cc{grid-template-columns:260px 1fr;}.cc .col:last-child{display:none;}}
@media(max-width:860px){.cc{grid-template-columns:1fr;}.weekgrid{grid-template-columns:repeat(3,1fr);}.kan{grid-template-columns:repeat(3,1fr);}.ct{grid-template-columns:1fr;}.kpis{grid-template-columns:repeat(2,1fr);}.mapgrid{grid-template-columns:1fr;}}

/* CALENDAR EVENTS */
.cal-event{border:1px solid var(--line);border-left:3px solid #7c5cbf;border-radius:var(--r-sm);padding:7px 9px;background:var(--surface);font-size:12px;}
.cal-event .ce-time{font-family:var(--mono);font-size:10.5px;color:var(--ink-3);margin-bottom:2px;}
.cal-event .ce-title{font-size:12px;line-height:1.3;color:var(--ink);}
.cal-event.all-day{border-left-color:#5b8a5e;}
.cal-divider{font-size:10px;font-weight:600;text-transform:uppercase;letter-spacing:.07em;color:var(--ink-3);padding:6px 2px 3px;display:flex;align-items:center;gap:6px;}
.cal-divider::after{content:"";flex:1;height:1px;background:var(--line-2);}
</style>
</head>
<body>

