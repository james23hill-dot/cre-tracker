// Deal tracker
const STAGES=[{id:'prelim',label:'Prelim',prob:'10%'},{id:'loi',label:'LOI',prob:'30%'},{id:'lease-sale',label:'Lease / Sale',prob:'60%'},{id:'under-contract',label:'Under Contract',prob:'85%'},{id:'closed',label:'Closed',prob:'100%'}];
function dealFee(d){return d.fee||Math.round(d.value*0.035*(STAGES.findIndex(s=>s.id===d.stage)+1)/5);}
function toggleDealFilter(type){if(type==='brok')STATE.dealFilterBrok=!STATE.dealFilterBrok;else STATE.dealFilterDev=!STATE.dealFilterDev;saveState();document.getElementById('deal-filter-brok').classList.toggle('on',STATE.dealFilterBrok);document.getElementById('deal-filter-dev').classList.toggle('on',STATE.dealFilterDev);renderDeals();}
function renderDeals(){
  const active=STATE.deals.filter(d=>d.stage!=='closed');
  document.getElementById('deal-summary').textContent=`${active.length} active deals \u00b7 ${fmtMoney(active.reduce((s,d)=>s+dealFee(d),0))} gross fees`;
  document.getElementById('tab-map-count').textContent=active.length;
  document.getElementById('kanban').innerHTML=STAGES.map(stage=>{
    let deals=STATE.deals.filter(d=>d.stage===stage.id);
    if(!STATE.dealFilterBrok)deals=deals.filter(d=>d.type!=='brok');
    if(!STATE.dealFilterDev)deals=deals.filter(d=>d.type!=='dev');
    const fees=deals.reduce((s,d)=>s+dealFee(d),0);
    const dealsHtml=deals.map(d=>{
      const bars=Array.from({length:4},(_,i)=>`<i class="${i<d.level?'on':''}"></i>`).join('');
      const levelCls=d.level===4?'max':d.level>=3?'hot':'';
      // Show linked project name on card
      const projName=d.projectId?(STATE.projects.find(p=>p.id===d.projectId)?.name||''):'';
      // Build key dates mini-timeline for deal card
      const datesHtml=(()=>{const parts=[];if(d.dateFirstContact)parts.push(`<span title="First contact">&#128222; ${fmtDisplay(d.dateFirstContact)}</span>`);if(d.dateLoiSent)parts.push(`<span title="LOI sent">&#128221; ${fmtDisplay(d.dateLoiSent)}</span>`);if(d.dateLeaseSent)parts.push(`<span title="Lease sent">&#128196; ${fmtDisplay(d.dateLeaseSent)}</span>`);return parts.length?`<div style="display:flex;flex-wrap:wrap;gap:8px;margin-top:7px;font-size:10.5px;color:var(--ink-3);font-family:var(--mono)">${parts.join('')}</div>`:''})();
      if(stage.id==='closed')return`<div class="deal ${d.type} closed-deal" onclick="openEditDeal('${d.id}')"><div class="dn">${d.name}</div><div class="ds">${d.location} &middot; ${d.size||'&mdash;'}</div>${datesHtml}<div class="df"><span class="badge good">won &middot; ${fmtMoney(d.fee||dealFee(d))}</span><span class="tag ${d.type}">${d.type==='brok'?'Brok':'Dev'}</span></div></div>`;
      const cc=STATE.contacts.filter(c=>(c.linkedDeals||[]).includes(d.id));
      return`<div class="deal ${d.type}" onclick="openEditDeal('${d.id}')"><div class="dn">${d.name}</div><div class="ds">${d.location} &middot; ${d.size||'&mdash;'}</div>${projName?`<div style="font-size:11px;color:var(--ink-3);margin-bottom:6px;">&#128193; ${projName}</div>`:''}<div class="df"><span class="level ${levelCls}">${bars}</span><span class="tag ${d.type}">${d.type==='brok'?'Brok':'Dev'}</span></div>${datesHtml}${cc.length?`<div style="margin-top:7px;display:flex;flex-wrap:wrap;gap:4px;">${cc.map(c=>`<span style="font-size:11px;background:var(--brok-soft);color:var(--brok);padding:2px 7px;border-radius:99px;font-weight:500">&#128100; ${c.name}</span>`).join('')}</div>`:''}</div>`;
    }).join('');
    return`<div class="kcol"><div class="kh"><span class="kt">${stage.label}</span><span class="ks">${deals.length}</span></div><div class="ksum">${stage.prob} &middot; ${fmtMoney(fees)} fees</div><div class="kb">${dealsHtml}<div class="addt" onclick="openModalForStage('${stage.id}')">+ new deal</div></div></div>`;
  }).join('');
}

