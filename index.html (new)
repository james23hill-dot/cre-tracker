function getWeekMonday(date){const d=new Date(date),day=d.getDay(),diff=day===0?-6:1-day;d.setDate(d.getDate()+diff);d.setHours(0,0,0,0);return d;}
function fmt(d){return`${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;}
function fmtDisplay(ds){if(!ds)return'';const d=new Date(ds+'T12:00:00');return d.toLocaleDateString('en-US',{month:'short',day:'numeric'});}
function fmtMoney(v){if(!v)return'$0';if(v>=1000000)return`$${(v/1000000).toFixed(1)}M`;if(v>=1000)return`$${(v/1000).toFixed(0)}K`;return`$${v}`;}
function initials(name){return name.split(' ').map(w=>w[0]).join('').toUpperCase().slice(0,2);}
function uid(){return'x'+Math.random().toString(36).slice(2,9);}
function todayStr(){return fmt(new Date());}
function daysBetween(a,b){return Math.round((new Date(b+'T12:00:00')-new Date(a+'T12:00:00'))/(1000*60*60*24));}
function followUpStatus(c){if(!c.followUpDate)return{txt:'none set',cls:'time'};const t=todayStr(),diff=daysBetween(t,c.followUpDate);if(diff<0)return{txt:`overdue ${Math.abs(diff)}d`,cls:'over'};if(diff===0)return{txt:'due today',cls:'today'};return{txt:fmtDisplay(c.followUpDate),cls:'time'};}

