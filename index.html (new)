async function fetchNews(){
  const panel=document.getElementById('newsPanel');
  panel.innerHTML='<div style="padding:12px 0;color:var(--ink-3);font-size:13px;text-align:center;">Loading live news&hellip;</div>';
  try{
    const query='commercial real estate South Carolina OR North Carolina OR Charlotte OR Greenville OR Charleston OR Raleigh OR Columbia OR "York County"';
    const res=await fetch(`https://newsapi.org/v2/everything?q=${encodeURIComponent(query)}&language=en&sortBy=publishedAt&pageSize=10&apiKey=${NEWS_API_KEY}`);
    const data=await res.json();
    if(data.status==='ok'&&data.articles?.length>0){
      panel.innerHTML=data.articles.filter(a=>a.title&&a.title!=='[Removed]').slice(0,7).map(a=>{
        const text=(a.title+' '+(a.description||'')).toLowerCase();
        let geo='SE Region';
        if(text.includes('york county')||text.includes('rock hill'))geo='York County';
        else if(text.includes('greenville'))geo='Greenville';else if(text.includes('charlotte'))geo='Charlotte';
        else if(text.includes('charleston'))geo='Charleston';else if(text.includes('columbia'))geo='Columbia';
        else if(text.includes('raleigh'))geo='Raleigh';else if(text.includes('spartanburg'))geo='Spartanburg';else if(text.includes('wilmington'))geo='Wilmington';
        const outlet=(a.source?.name||'News').slice(0,22);
        const diff=Math.floor((Date.now()-new Date(a.publishedAt))/60000);
        const ago=diff<60?diff+'m ago':diff<1440?Math.floor(diff/60)+'h ago':Math.floor(diff/1440)+'d ago';
        return`<div class="item"><div class="src"><span class="geo">${geo}</span> &middot; ${outlet} <span style="float:right;font-size:10px">${ago}</span></div><div class="hl" onclick="window.open('${a.url}','_blank')">${a.title.slice(0,88)}${a.title.length>88?'&hellip;':''}</div></div>`;
      }).join('');
    }else renderNewsFallback();
  }catch(e){renderNewsFallback();}
}
