async function pushToSupabase(){
  try{
    STATE._savedAt = Date.now();
    await sbClient.from('cre_state').upsert({id:'main', data: STATE, updated_at: new Date().toISOString()});
    // Flash sync dot
    const dot = document.getElementById('syncDot');
    if(dot){dot.style.opacity='1';setTimeout(()=>dot.style.opacity='0',1500);}
  }catch(e){console.warn('Supabase save failed:',e);}
}

async function pullFromSupabase(){
  try{
    const {data, error} = await sbClient.from('cre_state').select('data, updated_at').eq('id','main').single();
    if(error||!data) return;
    const remote = data.data;
    if(!remote||!remote.tasks) return;
    // Merge: use remote if it's newer than local
    const localTs = STATE._savedAt || 0;
    const remoteTs = new Date(data.updated_at).getTime();
    if(remoteTs > localTs){
      STATE = remote;
      STATE._savedAt = remoteTs;
      try{localStorage.setItem(STORE_KEY, JSON.stringify(STATE));}catch(e){}
      // Re-render everything with fresh data
      applyTheme();
      showTab(STATE.activeTab||'home');
      renderWeek();renderKPIs();renderProjects();renderFollowups();
      renderDeals();renderContacts();renderMap();
      document.getElementById('proj-filter-brok').classList.toggle('on',STATE.projFilterBrok!==false);
