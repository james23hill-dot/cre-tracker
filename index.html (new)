      const impDots=`<span class="imp i${imp}">${[1,2,3,4,5].map(n=>`<span class="${n<=imp?'on':''}"></span>`).join('')}</span>`;
      const cEl=t.contactId?(()=>{const c=STATE.contacts.find(x=>x.id===t.contactId);return c?`<span class="contact-link" onclick="showTab('contacts');setTimeout(()=>selectContact('${c.id}'),100);event.stopPropagation()">&#128100; ${c.name}</span>`:'';})():'';
      // Resolve project name from ID
      const projName=t.projectId?(STATE.projects.find(p=>p.id===t.projectId)?.name||t.projectId):'';
      const timeEl=t.time?`<span class="badge time">${t.time}</span>`:'';
      return`<div class="task ${t.type} ${t.done?'done':''} ${over} ${hide}" data-tid="${t.id}" ondblclick="openModal('task',STATE.tasks.find(x=>x.id==='${t.id}'))">
        <div class="ttop"><span class="cbx ${t.done?'on':''}" onclick="toggleTask('${t.id}',event)"></span><span class="ttl">${t.title}</span>
        <span class="task-actions">${impDots}<button onclick="openModal('task',STATE.tasks.find(x=>x.id==='${t.id}'));event.stopPropagation()" title="Edit" style="color:var(--ink-3);font-size:12px;padding:2px 4px;background:none;border:none;border-radius:4px;">&#9998;</button><button onclick="deleteTask('${t.id}',event)" title="Delete">&times;</button></span></div>
        <div class="tmeta">${projName?`<span class="tproj">${projName}</span>`:''}${cEl}${timeEl}</div>
      </div>`;
    }).join('');
    return`<div class="day ${isToday?'today':''}"><div class="dh"><span class="dow">${dayNames[i]}</span><span class="dn">${d.toLocaleDateString('en-US',{month:'short',day:'numeric'})}${isToday?' \u00b7 TODAY':''}</span></div><div class="dbody" id="day-${ds}">${tasksHtml}<div class="addt" onclick="openAddTask('${ds}')">+ add task</div></div></div>`;
  }).join('');
  updateWeekRing();
}

function toggleTask(id,e){e.stopPropagation();const t=STATE.tasks.find(x=>x.id===id);if(t){t.done=!t.done;saveState();updateWeekRing();const el=document.querySelector(`[data-tid="${id}"]`);if(el){el.classList.toggle('done',t.done);el.querySelector('.cbx').classList.toggle('on',t.done);}}}
function deleteTask(id,e){e.stopPropagation();if(!confirm('Delete this task?'))return;STATE.tasks=STATE.tasks.filter(x=>x.id!==id);saveState();renderWeek();renderKPIs();}
function toggleFilter(type){if(type==='brok')STATE.filterBrok=!STATE.filterBrok;else STATE.filterDev=!STATE.filterDev;saveState();document.getElementById('filter-brok').classList.toggle('on',STATE.filterBrok);document.getElementById('filter-dev').classList.toggle('on',STATE.filterDev);document.querySelectorAll('#weekGrid .task').forEach(el=>{const t=STATE.tasks.find(x=>x.id===el.dataset.tid);if(t)el.classList.toggle('hide',(t.type==='brok'&&!STATE.filterBrok)||(t.type==='dev'&&!STATE.filterDev));});}
function navWeek(dir){if(dir===0)STATE.weekOffset=0;else STATE.weekOffset+=dir;saveState();renderWeek();}
function updateWeekRing(){const all=document.querySelectorAll('#weekGrid .task'),done=document.querySelectorAll('#weekGrid .task.done').length,total=all.length,pct=total?Math.round(done/total*100):0,C=2*Math.PI*34;const prog=document.getElementById('weekProg');if(prog)prog.style.strokeDashoffset=(C*(1-pct/100)).toFixed(1);document.getElementById('weekPct').textContent=pct+'%';document.getElementById('weekCount').textContent=`${done} of ${total}`;}

