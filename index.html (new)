      </div>
      <div class="form-row-2">
        <div class="form-row" style="margin:0"><label>Time (optional)</label><input id="f-time" type="text" value="${data.time||''}" placeholder="e.g. 10:30a"/></div>
        <div class="form-row" style="margin:0"><label>Link to project</label><select id="f-proj"><option value="">— none —</option>${projOpts}</select></div>
      </div>
      <div class="form-row">
        <label>Contact (optional)</label>
        <div class="contact-input-wrap"><input type="text" id="taskContactInput" placeholder="Type a name to search or add&hellip;" autocomplete="off"/></div>
        <div class="contact-tags" id="taskContactTags"></div>
      </div>
      <div class="form-row">
        <label>Follow-up needed?</label>
        <div class="fu-row">
          <div><input type="number" id="f-fu-days" min="1" max="365" placeholder="In how many days" style="width:100%"/></div>
          <div class="fu-or">or</div>
          <div><input type="date" id="f-fu-date" value="${data.followUpDate||''}" style="width:100%"/></div>
        </div>
        <div style="font-size:11.5px;color:var(--ink-3);margin-top:5px;">Leave both blank for no follow-up</div>
      </div>
    </div>
    <div class="modal-footer">
      ${data.id?`<button class="btn danger" onclick="deleteTaskById('${data.id}')">Delete</button>`:''}
      <button class="btn" onclick="closeModal()">Cancel</button>
      <button class="btn primary" onclick="saveTask('${data.id||''}')">Save task</button>
    </div>`;
  selectedTaskContacts=data.contactId?(()=>{const c=STATE.contacts.find(x=>x.id===data.contactId);return c?[{id:c.id,name:c.name,ini:c.ini||initials(c.name),isNew:false}]:[]; })():[];
  setTimeout(()=>{
    initContactAutocomplete('taskContactInput','taskContactTags',selectedTaskContacts);
    const daysEl=document.getElementById('f-fu-days'),dateEl=document.getElementById('f-fu-date');
    if(daysEl)daysEl.addEventListener('input',()=>{if(daysEl.value)dateEl.value='';});
    if(dateEl)dateEl.addEventListener('input',()=>{if(dateEl.value)daysEl.value='';});
  },50);
}
function saveTask(existingId){
  const title=document.getElementById('f-title').value.trim();
  if(!title){toast('Please enter a task title.');return;}
  const type=document.getElementById('f-type').value,day=document.getElementById('f-day').value,time=document.getElementById('f-time').value.trim(),projId=document.getElementById('f-proj').value,importance=parseInt(document.getElementById('f-importance').value)||3;
  const fuDays=document.getElementById('f-fu-days')?.value,fuDate=document.getElementById('f-fu-date')?.value;
  let followUpDate='';
  if(fuDate)followUpDate=fuDate;
  else if(fuDays&&parseInt(fuDays)>0){const d=new Date();d.setDate(d.getDate()+parseInt(fuDays));followUpDate=fmt(d);}
  const taskContactIds=saveNewContactsFromArr(selectedTaskContacts,null),contactId=taskContactIds[0]||'';
  if(contactId&&followUpDate){const c=STATE.contacts.find(x=>x.id===contactId);if(c){c.followUpDate=followUpDate;c.followUpNote=`Follow-up from task: ${title}`;}}
  if(existingId){const t=STATE.tasks.find(x=>x.id===existingId);if(t)Object.assign(t,{title,type,day,time,projectId:projId,importance,contactId,followUpDate});}
  else STATE.tasks.push({id:uid(),title,type,day,time,projectId:projId,done:false,importance,contactId,followUpDate});
  const newCount=selectedTaskContacts.filter(c=>c.isNew).length;selectedTaskContacts=[];
  saveState();closeModal();renderWeek();renderKPIs();renderFollowups();renderContacts();
  toast(existingId?'Task updated.':`Task added.${newCount?' '+newCount+' new contact.':''}${contactId&&followUpDate?' Follow-up scheduled.':''}`);
}
function deleteTaskById(id){if(!confirm('Delete task?'))return;STATE.tasks=STATE.tasks.filter(x=>x.id!==id);saveState();closeModal();renderWeek();renderKPIs();toast('Task deleted.');}

