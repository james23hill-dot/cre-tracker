// OUTLOOK CALENDAR — MSAL.js + Microsoft Graph
// ============================================================
const MS_CLIENT_ID = '3047330a-e275-4c8c-9336-2f6e0c7d5081';
const MS_TENANT_ID = '82c00f53-836a-4d08-8462-c9b76676f801';

const msalConfig = {
  auth: {
    clientId: MS_CLIENT_ID,
    authority: `https://login.microsoftonline.com/${MS_TENANT_ID}`,
    redirectUri: window.location.href.split('?')[0].split('#')[0],
  },
  cache: { cacheLocation: 'localStorage', storeAuthStateInCookie: false },
};

let msalInstance = null;
let calAccount = null;
let CAL_EVENTS = {};

function getMsalInstance() {
  if (!msalInstance) msalInstance = new msal.PublicClientApplication(msalConfig);
  return msalInstance;
}

async function getCalToken() {
  // Local file mode — use pasted token from localStorage
  if (isLocalFile()) {
    return localStorage.getItem('cre_ms_token') || null;
  }
  // HTTP mode — use MSAL silent token
  try {
    const app = getMsalInstance();
    const accounts = app.getAllAccounts();
    if (accounts.length === 0) return null;
    calAccount = accounts[0];
    const result = await app.acquireTokenSilent({
      scopes: ['Calendars.Read'],
      account: calAccount,
    });
    return result.accessToken;
  } catch (e) {
    return null;
  }
}

function isLocalFile() {
  return window.location.protocol === 'file:';
}

async function toggleOutlookAuth() {
  // Check if already connected via stored token
  const stored = localStorage.getItem('cre_ms_token');
  if (stored) {
    // Already connected — clicking again disconnects
    if (confirm('Disconnect Outlook calendar?')) {
      disconnectOutlook();
    }
    return;
  }
  // Show token paste modal
  showTokenModal();
}

function showTokenModal() {
  const stored = localStorage.getItem('cre_ms_token') || '';
  const backdrop = document.getElementById('modalBackdrop');
  const box = document.getElementById('modalBox');
  backdrop.style.display = 'flex';
  box.innerHTML = `
    <div class="modal-h">
      <h3>&#128197; Connect Outlook Calendar</h3>
      <button class="modal-close" onclick="closeModal()">&times;</button>
    </div>
    <div class="modal-b">
      <p style="font-size:13.5px;color:var(--ink-2);margin-bottom:16px;line-height:1.6;">
        Connect your Outlook calendar in 3 steps — takes about 30 seconds:
      </p>
      <div style="background:var(--surface-2);border:1px solid var(--line);border-radius:var(--r-sm);padding:14px;font-size:13px;line-height:1.8;margin-bottom:16px;">
        <strong>Step 1:</strong> Open <a href="https://developer.microsoft.com/en-us/graph/graph-explorer" target="_blank" style="color:var(--brok);font-weight:600;">Graph Explorer &#8599;</a> in a new tab<br>
        <strong>Step 2:</strong> Click <strong>Sign in to Graph Explorer</strong> &rarr; sign in with <strong>jhill@warrennorman.com</strong><br>
        <strong>Step 3:</strong> Once signed in, click your <strong>profile picture</strong> (top right) &rarr; click <strong>Access token</strong> tab &rarr; click <strong>Copy</strong><br>
        <strong>Step 4:</strong> Paste it below and click Connect
      </div>
      <p style="font-size:12px;color:var(--ink-3);margin-bottom:12px;">&#9888; Token expires after ~1 hour. Just paste a fresh one when calendar stops loading.</p>
      <div class="form-row">
        <label>Access Token</label>
        <textarea id="msTokenInput" rows="4" style="resize:vertical;font-family:var(--mono);font-size:11px;" placeholder="eyJ0eXAiOiJKV1QiLCJub...">${stored}</textarea>
      </div>
      <p style="font-size:11.5px;color:var(--ink-3);">Token is stored locally in your browser. You'll need to refresh it when it expires (~1 hour).</p>
    </div>
    <div class="modal-footer">
      ${stored ? '<button class="btn danger" onclick="disconnectOutlook()">Disconnect</button>' : ''}
      <button class="btn" onclick="closeModal()">Cancel</button>
      <button class="btn primary" onclick="saveOutlookToken()">Connect &amp; Load Calendar</button>
    </div>`;
}

function saveOutlookToken() {
  const token = document.getElementById('msTokenInput')?.value?.trim();
  if (!token || token.length < 50) { toast('Please paste a valid access token.'); return; }
  localStorage.setItem('cre_ms_token', token);
  closeModal();
  updateCalBtn(true, 'Outlook');
  toast('Outlook connected — loading calendar…');
  fetchCalendarWeek();
}

function disconnectOutlook() {
  localStorage.removeItem('cre_ms_token');
  CAL_EVENTS = {};
  renderWeekWithCal();
  closeModal();
  updateCalBtn(false);
  toast('Outlook disconnected.');
}

function updateCalBtn(connected, name) {
  const btn = document.getElementById('calBtn');
  const icon = document.getElementById('calBtnIcon');
  const label = document.getElementById('calBtnLabel');
  if (!btn) return;
  if (connected === null) {
    label.textContent = 'Connecting…';
    btn.style.opacity = '0.6';
  } else if (connected) {
    icon.textContent = '✅';
    label.textContent = name || calAccount?.name?.split(' ')[0] || 'Outlook';
    btn.style.opacity = '1';
    btn.style.background = 'var(--good-soft)';
    btn.style.borderColor = 'var(--good)';
    btn.style.color = 'var(--good)';
  } else {
    icon.innerHTML = '&#128197;';
    label.textContent = 'Connect Outlook';
    btn.style.opacity = '1';
    btn.style.background = '';
    btn.style.borderColor = '';
    btn.style.color = '';
  }
}

async function initMsal() {
  // Local file mode — check for stored token
  if (isLocalFile()) {
    const stored = localStorage.getItem('cre_ms_token');
    if (stored) {
      updateCalBtn(true, 'Outlook');
      fetchCalendarWeek();
    }
    return;
  }
  // HTTP mode — initialize MSAL
  try {
    const app = getMsalInstance();
    await app.handleRedirectPromise();
    const accounts = app.getAllAccounts();
    if (accounts.length > 0) {
      calAccount = accounts[0];
      updateCalBtn(true);
      fetchCalendarWeek();
    }
  } catch (e) {
    console.warn('MSAL init error', e);
  }
}

async function fetchCalendarWeek() {
  const token = await getCalToken();
  if (!token) return;
  try {
    const mon = currentWeekMonday();
    const start = new Date(mon);
    const end = new Date(mon); end.setDate(end.getDate() + 5);
    // Graph needs local time ISO — use UTC
    const url = `https://graph.microsoft.com/v1.0/me/calendarView?startDateTime=${start.toISOString()}&endDateTime=${end.toISOString()}&$select=subject,start,end,isAllDay,location&$orderby=start/dateTime&$top=100`;
    const res = await fetch(url, { headers: { Authorization: `Bearer ${token}` } });
    if (!res.ok) { console.warn('Calendar fetch failed:', res.status); return; }
    const data = await res.json();
    CAL_EVENTS = {};
    (data.value || []).forEach(ev => {
      // Convert event start to local date string
      let ds;
      if (ev.isAllDay) {
        ds = ev.start.dateTime.slice(0, 10);
      } else {
        // Graph returns UTC ISO — convert to local date
        ds = new Date(ev.start.dateTime + (ev.start.dateTime.endsWith('Z') ? '' : 'Z')).toLocaleDateString('en-CA');
      }
      if (!CAL_EVENTS[ds]) CAL_EVENTS[ds] = [];
      CAL_EVENTS[ds].push(ev);
    });
    renderWeekWithCal();
  } catch (e) { console.warn('Calendar error', e); }
}

function fmtCalTime(iso, isAllDay) {
  if (isAllDay) return 'All day';
  const suffix = iso.endsWith('Z') ? '' : 'Z';
  const d = new Date(iso + suffix);
  return d.toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit' });
}

function calEventsHtml(ds) {
  const evs = CAL_EVENTS[ds];
  if (!evs || !evs.length) return '';
  const sorted = [...evs].sort((a, b) => {
    if (a.isAllDay && !b.isAllDay) return -1;
    if (!a.isAllDay && b.isAllDay) return 1;
    return new Date(a.start.dateTime) - new Date(b.start.dateTime);
  });
  const evHtml = sorted.map(ev => {
    const timeStr = fmtCalTime(ev.start.dateTime, ev.isAllDay);
    const endStr = ev.isAllDay ? '' : ` – ${fmtCalTime(ev.end.dateTime, false)}`;
    const loc = ev.location?.displayName ? `<span style="font-size:10px;color:var(--ink-3);margin-top:1px;display:block;">&#128205; ${ev.location.displayName.slice(0, 35)}</span>` : '';
    return `<div class="cal-event ${ev.isAllDay ? 'all-day' : ''}"><div class="ce-time">&#128337; ${timeStr}${endStr}</div><div class="ce-title">${ev.subject || '(No title)'}</div>${loc}</div>`;
  }).join('');
  return `<div class="cal-divider">Outlook</div>${evHtml}`;
}

function renderWeekWithCal() {
  const mon = currentWeekMonday();
  for (let i = 0; i < 5; i++) {
    const d = new Date(mon); d.setDate(d.getDate() + i);
    const ds = fmt(d);
    const dayBody = document.getElementById('day-' + ds);
    if (!dayBody) continue;
    dayBody.querySelectorAll('.cal-event,.cal-divider').forEach(el => el.remove());
    const addBtn = dayBody.querySelector('.addt');
    const calHtml = calEventsHtml(ds);
    if (calHtml && addBtn) {
      const tmp = document.createElement('div'); tmp.innerHTML = calHtml;
      while (tmp.firstChild) dayBody.insertBefore(tmp.firstChild, addBtn);
    }
  }
}

